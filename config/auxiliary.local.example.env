# Copy this file to auxiliary.local.env. The local file is ignored by Git.
# Elasticsearch and Neo4j are rebuildable projections; MySQL remains the source of truth.
NOVELFORGE_ES_URL=http://127.0.0.1:9200
NOVELFORGE_ES_ENABLED=false
NOVELFORGE_ES_INDEX=novelforge-local-memory
NOVELFORGE_EMBEDDING_DIMENSIONS=1536
# Enable only after the shadow retrieval evaluation passes for your novels.
NOVELFORGE_RETRIEVAL_CONTEXT_ENABLED=false
NOVELFORGE_RETRIEVAL_RESULT_LIMIT=5
NOVELFORGE_RETRIEVAL_MAX_CONTEXT_CHARS=6000
NOVELFORGE_NEO4J_ENABLED=false
NOVELFORGE_NEO4J_HTTP_URL=http://127.0.0.1:7474
NOVELFORGE_NEO4J_USERNAME=neo4j
NOVELFORGE_NEO4J_PASSWORD=replace_me
NOVELFORGE_NEO4J_PROJECT_KEY=novelforge-local
NOVELFORGE_PROJECTION_POLL_INTERVAL_MS=5000

# Copy this file to database.local.env. The local file is ignored by Git.
# Use a database created only for NovelForge; never point this at another project's schema.
NOVELFORGE_DB_URL=jdbc:mysql://127.0.0.1:3306/novelforge_local?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
NOVELFORGE_DB_USERNAME=replace_me
NOVELFORGE_DB_PASSWORD=replace_me
NOVELFORGE_DB_DRIVER=com.mysql.cj.jdbc.Driver
NOVELFORGE_STORAGE_MODE=normalized
NOVELFORGE_NORMALIZED_SHADOW_ENABLED=true

# One-time legacy import. Keep false during ordinary starts.
NOVELFORGE_IMPORT_ON_STARTUP=false
NOVELFORGE_LEGACY_IMPORT_URL=jdbc:h2:file:./data/novelforge;ACCESS_MODE_DATA=r;IFEXISTS=TRUE
NOVELFORGE_LEGACY_IMPORT_USERNAME=sa
NOVELFORGE_LEGACY_IMPORT_PASSWORD=

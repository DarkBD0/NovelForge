# 复制本文件并重命名为 model.local.env，然后填写私有 API Key。
# model.local.env 只保存在本机，已经被 .gitignore 排除，请勿提交。
NOVELFORGE_MODEL_MODE=http
NOVELFORGE_MODEL_BASE_URL=https://api.deepseek.com
NOVELFORGE_MODEL_API_KEY=replace-with-your-private-key
NOVELFORGE_MODEL_NAME=deepseek-v4-flash
NOVELFORGE_MODEL_TIMEOUT=180
NOVELFORGE_MAX_OUTPUT_TOKENS=12000
NOVELFORGE_MAX_CONTEXT_CHARS=160000
NOVELFORGE_TOKEN_LIMIT_FIELD=auto
NOVELFORGE_RESPONSE_FORMAT=none
NOVELFORGE_CONTINUITY_SHADOW_ENABLED=false
NOVELFORGE_PLOT_FORESHADOW_SHADOW_ENABLED=false
NOVELFORGE_STRUCTURED_MEMORY_CONTINUITY_AB_ENABLED=false
NOVELFORGE_HISTORICAL_STRUCTURED_MEMORY_SHADOW_ENABLED=false
NOVELFORGE_HISTORICAL_STRUCTURED_MEMORY_SHADOW_MAX_CHAPTERS=5
NOVELFORGE_HISTORICAL_STRUCTURED_MEMORY_CONTINUITY_AB_ENABLED=false
# 开启灰度前还必须把上面的 NOVELFORGE_HISTORICAL_STRUCTURED_MEMORY_SHADOW_ENABLED 设为 true。
NOVELFORGE_HISTORICAL_CONTINUITY_GRAY_ENABLED=false
# 只填写参与灰度的小说 ID，多个 ID 用英文逗号分隔；不要在首次启用时填写 *。
NOVELFORGE_HISTORICAL_CONTINUITY_GRAY_NOVEL_IDS=
NOVELFORGE_HISTORICAL_CONTINUITY_GRAY_MAX_CHAPTERS=4
NOVELFORGE_STRUCTURED_MEMORY_MAX_CONTEXT_CHARS=6000
NOVELFORGE_STRUCTURED_MEMORY_MAX_ENTITIES=40
NOVELFORGE_STRUCTURED_MEMORY_MAX_RELATIONS=80

# 复制本文件并重命名为 model.local.env，然后填写私有 API Key。
# model.local.env 只保存在本机，已经被 .gitignore 排除，请勿提交。
NOVELFORGE_MODEL_MODE=http
NOVELFORGE_MODEL_BASE_URL=https://api.deepseek.com
NOVELFORGE_MODEL_API_KEY=replace-with-your-private-key
NOVELFORGE_MODEL_NAME=deepseek-v4-flash
NOVELFORGE_MODEL_TIMEOUT=180
NOVELFORGE_MAX_OUTPUT_TOKENS=12000
NOVELFORGE_MAX_CONTEXT_CHARS=160000
NOVELFORGE_TOKEN_LIMIT_FIELD=auto
NOVELFORGE_RESPONSE_FORMAT=none
NOVELFORGE_CONTINUITY_SHADOW_ENABLED=false
NOVELFORGE_PLOT_FORESHADOW_SHADOW_ENABLED=false
